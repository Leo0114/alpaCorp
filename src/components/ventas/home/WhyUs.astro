---
import {
  MdOutlineCarpenter,
  MdOutlineLocalFireDepartment,
  MdOutlinePrecisionManufacturing,
  MdOutlineSpeed,
} from "react-icons/md";
import t from "@/constants/ventas.json";

const { why } = t;

const icons = {
  manufacturing: MdOutlinePrecisionManufacturing,
  fire: MdOutlineLocalFireDepartment,
  carpenter: MdOutlineCarpenter,
  speed: MdOutlineSpeed,
} as const;

// Cada pilar hereda el color de su rol: navy = operación, verde = certificación, madera = material
const tones = {
  navy: {
    badge: "bg-navy-900 text-white",
    tag: "text-navy-900",
    strip: "bg-navy-900",
  },
  emerald: {
    badge: "bg-emerald-950 text-emerald-300",
    tag: "text-[#005228]",
    strip: "bg-emerald",
  },
  timber: {
    badge: "bg-timber-light text-timber-ink",
    tag: "text-timber-ink",
    strip: "bg-timber",
  },
  sky: {
    badge: "bg-navy-100 text-navy-900",
    tag: "text-navy-900",
    strip: "bg-navy-300",
  },
} as const;
---

<section class="bg-white py-16 md:py-24" aria-labelledby="why-title">
  <div class="mx-auto max-w-7xl px-4 md:px-12">
    <header class="reveal mx-auto mb-12 max-w-3xl text-center md:mb-16">
      <span
        class="text-[0.6875rem] leading-4 font-bold tracking-widest text-orange uppercase"
        >{why.eyebrow}</span
      >
      <h2
        id="why-title"
        class="mt-3 text-[clamp(1.75rem,1.3rem+1.8vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.024em] text-balance text-navy-900"
      >
        {why.title}
      </h2>
    </header>

    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        why.pillars.map((pillar, i) => {
          const Icon = icons[pillar.icon as keyof typeof icons];
          const tone = tones[pillar.tone as keyof typeof tones];
          return (
            <li
              class="reveal relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface-subtle p-6"
              style={`transition-delay: ${i * 70}ms`}
            >
              <span
                class={`absolute inset-x-0 top-0 h-[3px] ${tone.strip}`}
                aria-hidden="true"
              />
              <span
                class={`grid size-12 place-items-center rounded-md ${tone.badge}`}
              >
                <Icon className="size-6" aria-hidden="true" />
              </span>
              <h3 class="mt-5 text-lg leading-snug font-bold tracking-[-0.01em] text-navy-900">
                {pillar.title}
              </h3>
              <p class="mt-2 grow text-sm leading-relaxed text-ink-muted">
                {pillar.description}
              </p>
              <span
                class={`mt-6 border-t border-line pt-3 text-[0.6875rem] leading-4 font-bold tracking-[0.08em] uppercase ${tone.tag}`}
              >
                {pillar.tag}
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

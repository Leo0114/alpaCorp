---
import {
  MdOutlineHeadsetMic,
  MdOutlineLocalShipping,
  MdOutlineMail,
  MdOutlinePhone,
  MdOutlineVerifiedUser,
} from "react-icons/md";
import QuoteForm from "./QuoteForm";
import t from "@/constants/ventas.json";

const { quote, company } = t;
---

<section
  id="cotizacion"
  class="bg-navy-50 py-16 md:py-24"
  aria-labelledby="quote-title"
>
  <div
    class="mx-auto grid max-w-7xl items-start gap-10 px-4 md:px-12 lg:grid-cols-12 lg:gap-12"
  >
    <div class="reveal flex flex-col gap-6 lg:sticky lg:top-28 lg:col-span-5">
      <div>
        <span
          class="text-[0.6875rem] leading-4 font-bold tracking-widest text-orange uppercase"
          >{quote.eyebrow}</span
        >
        <h2
          id="quote-title"
          class="mt-3 text-[clamp(1.75rem,1.3rem+1.8vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.024em] text-balance text-navy-900"
        >
          {quote.title}
        </h2>
        <p class="mt-4 leading-relaxed text-ink-muted">{quote.description}</p>
      </div>

      <div class="rounded-lg border border-line bg-white p-5">
        <div class="flex items-center gap-3">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-full bg-navy-900 text-white"
          >
            <MdOutlineHeadsetMic className="size-5" aria-hidden="true" />
          </span>
          <div>
            <p class="font-bold text-navy-900">{quote.deskTitle}</p>
            <p class="text-sm text-ink-muted">{quote.deskSubtitle}</p>
          </div>
        </div>
        <ul
          class="mt-4 flex flex-col gap-2.5 border-t border-line pt-4 text-sm text-ink"
        >
          <li>
            <a
              href={company.phoneHref}
              class="flex items-center gap-2.5 hover:text-navy-800"
            >
              <MdOutlinePhone
                className="size-4 shrink-0 text-navy-700"
                aria-hidden="true"
              />
              Directo: <strong class="tabular-nums">{company.phone}</strong>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${company.email}`}
              class="flex items-center gap-2.5 hover:text-navy-800"
            >
              <MdOutlineMail
                className="size-4 shrink-0 text-navy-700"
                aria-hidden="true"
              />
              <strong>{company.email}</strong>
            </a>
          </li>
          <li class="flex items-start gap-2.5 leading-relaxed text-ink-muted">
            <MdOutlineLocalShipping
              className="mt-0.5 size-4 shrink-0 text-orange"
              aria-hidden="true"
            />
            {quote.coverage}
          </li>
        </ul>
      </div>

      <div class="flex items-center gap-4 rounded-lg bg-emerald-950 p-5">
        <span
          class="grid size-12 shrink-0 place-items-center rounded-md bg-[#001b09] text-emerald-300"
        >
          <MdOutlineVerifiedUser className="size-7" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-bold text-emerald-300">{quote.sealTitle}</h3>
          <p class="mt-0.5 text-sm leading-snug text-navy-300">
            {quote.sealText}
          </p>
        </div>
      </div>
    </div>

    <div
      class="reveal rounded-lg border border-line bg-white p-6 shadow-lift md:p-10 lg:col-span-7"
      style="transition-delay: 100ms"
    >
      <div class="mb-8">
        <h3
          class="text-2xl leading-tight font-bold tracking-[-0.018em] text-navy-900 md:text-[1.75rem]"
        >
          {quote.form.title}
        </h3>
        <p class="mt-2 text-ink-muted">{quote.form.subtitle}</p>
      </div>
      <QuoteForm client:visible />
    </div>
  </div>
</section>

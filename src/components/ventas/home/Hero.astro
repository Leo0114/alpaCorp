---
import { Image } from "astro:assets";
import { FaWhatsapp } from "react-icons/fa6";
import {
  MdOutlineCalendarMonth,
  MdOutlineFactory,
  MdOutlineInventory2,
  MdOutlineRequestQuote,
  MdOutlineVerified,
} from "react-icons/md";
import heroImage from "@/assets/ventas/carton.avif";
import LinkButton from "@/components/ventas/ui/LinkButton.astro";
import t from "@/constants/ventas.json";

const { hero, company } = t;

const trustIcons = {
  calendar: { Icon: MdOutlineCalendarMonth, color: "text-orange" },
  verified: { Icon: MdOutlineVerified, color: "text-emerald-300" },
  factory: { Icon: MdOutlineFactory, color: "text-timber" },
} as const;
---

<section
  class="relative isolate overflow-hidden bg-navy-950 text-white"
  aria-labelledby="hero-title"
>
  <!-- Profundidad: degradado + retícula de plano técnico -->
  <div
    class="absolute inset-0 -z-10 bg-linear-to-br from-navy-950 via-navy-900 to-navy-950"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(rgb(175_200_237/0.16)_1px,transparent_1px)] bg-size-[24px_24px] mask-[linear-gradient(to_bottom,black,transparent_90%)]"
  >
  </div>
  <div
    class="absolute -top-40 right-[-10%] -z-10 size-[42rem] rounded-full bg-navy-700/40 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 pt-12 pb-16 md:px-12 md:pt-20 md:pb-20">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p
          class="reveal inline-flex max-w-xl items-start gap-3 self-start rounded-md border-l-4 border-orange bg-white/8 py-2.5 pr-4 pl-3 text-[0.8125rem] leading-snug text-navy-200 backdrop-blur-md"
        >
          <MdOutlineInventory2
            className="mt-0.5 size-4 shrink-0 text-orange"
            aria-hidden="true"
          />
          <span>
            <strong
              class="mr-1 font-bold tracking-[0.06em] text-orange uppercase"
              >{hero.badgeStrong}</strong
            >
            {hero.badge}
          </span>
        </p>

        <h1
          id="hero-title"
          class="reveal text-[clamp(2.25rem,1.4rem+3.6vw,3.75rem)] leading-[1.04] font-extrabold tracking-[-0.032em] text-balance"
          style="transition-delay: 60ms"
        >
          {hero.title}
        </h1>

        <p
          class="reveal max-w-2xl text-lg leading-relaxed text-navy-100/85 md:text-xl"
          style="transition-delay: 120ms"
        >
          {hero.subtitle}
        </p>

        <div
          class="reveal flex flex-col gap-3 pt-1 sm:flex-row sm:flex-wrap"
          style="transition-delay: 180ms"
        >
          <LinkButton href="#cotizacion">
            <MdOutlineRequestQuote className="size-5" aria-hidden="true" />
            {hero.ctaPrimary}
          </LinkButton>
          <LinkButton href={company.whatsappHref} external variant="whatsapp">
            <FaWhatsapp className="size-5" aria-hidden="true" />
            {hero.ctaSecondary}
          </LinkButton>
        </div>
      </div>

      <!-- Ficha de producto flotante -->
      <figure
        class="reveal relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none"
        style="transition-delay: 160ms"
      >
        <div
          class="overflow-hidden rounded-lg bg-white shadow-[0_24px_64px_rgb(0_0_0/0.35)] ring-1 ring-white/10"
        >
          <Image
            src={heroImage}
            alt={hero.imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            class="aspect-[4/3] w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption
            class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-5 py-4"
          >
            <span
              class="text-[0.9375rem] font-bold tracking-[-0.01em] text-navy-900"
              >{hero.imageCaption}</span
            >
            <span
              class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-emerald px-2.5 py-1 whitespace-nowrap text-[0.6875rem] font-bold tracking-[0.06em] text-[#005228] uppercase"
            >
              <span class="size-1.5 rounded-full bg-emerald" aria-hidden="true"
              ></span>
              {hero.imageTag}
            </span>
          </figcaption>
        </div>
      </figure>
    </div>

    <!-- Indicadores de confianza -->
    <ul
      class="mt-14 grid gap-3 border-t border-white/10 pt-8 md:mt-16 md:grid-cols-3 md:gap-4"
    >
      {
        hero.trust.map((item, i) => {
          const { Icon, color } =
            trustIcons[item.icon as keyof typeof trustIcons];
          return (
            <li
              class="reveal flex items-center gap-4 rounded-lg bg-white/5 p-4 ring-1 ring-white/8 backdrop-blur-sm"
              style={`transition-delay: ${200 + i * 70}ms`}
            >
              <span
                class={`grid size-12 shrink-0 place-items-center rounded-md bg-white/10 ${color}`}
              >
                <Icon className="size-7" aria-hidden="true" />
              </span>
              <span class="flex flex-col gap-0.5">
                <span class="text-[0.9375rem] leading-snug font-bold text-white">
                  {item.title}
                </span>
                <span class="text-[0.6875rem] leading-4 font-bold tracking-[0.08em] text-navy-300 uppercase">
                  {item.caption}
                </span>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

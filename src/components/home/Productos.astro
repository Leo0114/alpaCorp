---
import { getCollection } from "astro:content";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ProductCard from "@/components/productos/ProductCard.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { Button } from "@/components/ui/Button";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const data = i18n.home.productosSection;
const productsHref = localizePath(lang, "products");

const productos = (
  await getCollection("productos", (item) => item.id.startsWith(`${lang}/`))
).sort((a, b) => a.data.order - b.data.order);
---

<section id="productos" class="bg-panel">
  <div class="container-x py-16 lg:py-24">
    <SectionHeading
      topTag={data.topTag}
      title={data.title}
      align="center"
    />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        productos.map((producto, index) => (
          <ScrollReveal client:visible delay={(index % 3) * 0.1} className="h-full">
            <ProductCard producto={producto} cta={data.cta} />
          </ScrollReveal>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <Button variant="secondary" size="lg" href={productsHref}>
        {data.ctaAll}
      </Button>
    </div>
  </div>
</section>

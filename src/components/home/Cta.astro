---
import { Image } from "astro:assets";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { Button } from "@/components/ui/Button";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";
import ctaImage from "@/assets/images/imgw43-scaled.avif";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const data = i18n.home.ctaComponent;
const contactHref = localizePath(lang, "contact");
---

<section class="relative isolate overflow-hidden bg-primary">
  <Image
    src={ctaImage}
    alt={data.imageAlt}
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-t from-primary via-primary/40 to-black/80"
    aria-hidden="true"
  >
  </div>

  <div class="container-x py-16 lg:py-24">
    <ScrollReveal client:visible>
      <div class="max-w-3xl">
        <p
          class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-secondary"
        >
          {data.topTag}
        </p>
        <h2
          class="font-display text-2xl font-extrabold leading-tight text-white sm:text-3xl lg:text-4xl"
        >
          {data.title}
        </h2>
        <span class="mt-6 block h-1 w-16 rounded-full bg-secondary"></span>
        <p class="mt-6 text-base leading-relaxed text-white/80">
          {data.p1}
        </p>
        <Button
          variant="secondary"
          size="lg"
          href={contactHref}
          className="mt-8"
        >
          {data.bgButton}
        </Button>
      </div>
    </ScrollReveal>
  </div>
</section>

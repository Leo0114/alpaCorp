---
import ScrollReveal from "@/components/shared/ScrollReveal";
import { indicadoresClave } from "@/constants/home";
---

<section class="bg-primary" aria-label="Indicadores clave de Empaques Industriales ALPA">
  <div class="container-x py-14 lg:py-16">

    <p class="mb-10 text-center text-xs font-semibold uppercase tracking-[0.35em] text-secondary">
      {indicadoresClave.topTag}
    </p>

    <div class="grid grid-cols-2 gap-px bg-white/10 sm:grid-cols-3 lg:grid-cols-5 rounded-2xl overflow-hidden">
      {
        indicadoresClave.items.map((item, index) => (
          <ScrollReveal
            client:visible
            direction="up"
            delay={index * 0.08}
            className="flex flex-col items-center justify-center gap-2 bg-primary px-6 py-10 text-center"
          >
            <span class="font-display text-4xl font-extrabold text-secondary sm:text-5xl">
              {item.value}
            </span>
            <span class="text-sm font-semibold text-white">{item.label}</span>
            {item.note && (
              <span class="text-xs text-white/40">{item.note}</span>
            )}
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>

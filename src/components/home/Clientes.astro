---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ClientesSlider, {
  type ClientLogo,
} from "@/components/home/ClientesSlider";
import { getI18N, getLang } from "@/i18n/i18n";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const data = i18n.home.clientesSection;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/marcas/*.{png,jpg,jpeg,webp,avif,svg}",
  { eager: true },
);

const logos: ClientLogo[] = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod], index) => ({
    src: mod.default.src,
    alt: `${data.logoAlt} ${index + 1}`,
    width: mod.default.width,
    height: mod.default.height,
  }));
---

<section class="bg-panel">
  <div class="container-x py-16 lg:py-20">
    <SectionHeading
      topTag={data.topTag}
      title={data.title}
      align="center"
    />

    <div class="mt-12">
      <ClientesSlider client:visible logos={logos} />
    </div>
  </div>
</section>

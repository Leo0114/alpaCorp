---
import { Image } from "astro:assets";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";
import image from "@/assets/images/4786.avif";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);

const cards = [
  {
    ...i18n.home.heroIntro.cards[0],
    href: "#productos",
    image,
    featured: true,
  },
  {
    ...i18n.home.heroIntro.cards[1],
    href: "#servicios",
    image,
    featured: false,
  },
  {
    ...i18n.home.heroIntro.cards[2],
    href: localizePath(lang, "about"),
    image,
    featured: false,
  },
];
---

<section class="bg-canvas">
  <div class="container-x py-10 sm:py-14">
    <div class="grid gap-5 lg:grid-cols-2 lg:grid-rows-2">
      {
        cards.map((card, index) => (
          <a
            href={card.href}
            class:list={[
              "group relative isolate flex min-h-[18rem] flex-col justify-end overflow-hidden rounded-2xl p-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary",
              card.featured && "lg:row-span-2 lg:min-h-[34rem]",
            ]}
          >
            <Image
              src={card.image}
              alt={card.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              loading={index === 0 ? "eager" : "lazy"}
              class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div
              class="absolute inset-0 -z-10 bg-gradient-to-t from-primary via-primary/70 to-primary/10 transition-opacity duration-500 group-hover:from-primary group-hover:via-primary/80"
              aria-hidden="true"
            />

            <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">
              {card.title}
            </h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-white/80">
              {card.text}
            </p>
            <span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-secondary px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-white transition-colors duration-300 group-hover:bg-white group-hover:text-primary">
              {card.cta}
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { Button } from "@/components/ui/Button";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";
import nuestraEmpresaImage from "@/assets/images/img04.avif";
import logo from "@/assets/images/logo.png";

interface Props {
  showCta?: boolean;
  id?: string;
}

const { showCta = true, id = "nuestra-empresa" } = Astro.props;

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const data = i18n.home.nuestraEmpresa;
const href = localizePath(lang, "about");
---

<section id={id} class="bg-canvas">
  <div class="container-x grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
    <ScrollReveal client:visible direction="right">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-secondary">
        {data.topTag}
      </p>
      <h2
        class="font-display text-2xl font-extrabold leading-tight text-ink sm:text-3xl lg:text-4xl"
      >
        {data.title}
      </h2>
      <span class="mt-6 block h-1 w-16 rounded-full bg-secondary"></span>

      <div class="mt-6 space-y-4 text-base leading-relaxed text-muted">
        <p>{data.p1}</p>
        <p>{data.p2}</p>
        <p>{data.p3}</p>
      </div>

      {
        showCta && (
          <Button
            variant="secondary"
            size="lg"
            href={href}
            className="mt-8"
          >
            {data.bgButton}
          </Button>
        )
      }
    </ScrollReveal>

    <ScrollReveal client:visible direction="left" delay={0.1}>
      <div class="relative">
        <Image
          src={nuestraEmpresaImage}
          alt={data.imageAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          class="aspect-4/3 w-full rounded-2xl object-cover shadow-xl"
        />
        <div
          class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-line bg-canvas p-5 shadow-xl sm:block"
        >
          <Image
            src={logo}
            alt={data.logoAlt}
            widths={[160, 320]}
            sizes="160px"
            loading="lazy"
            class="h-16 w-auto object-contain dark:brightness-0 dark:invert"
          />
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>

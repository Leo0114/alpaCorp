---
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const data = i18n.home.marcasAncla;

const brandList = [
  { name: "Whirlpool", key: "whirlpool" },
  { name: "LG Electronics", key: "lg" },
  { name: "Vitro", key: "vitro" },
  { name: "Mekra Lang", key: "mekraLang" },
  { name: "Thermotek", key: "thermotek" },
  { name: "Foremes", key: "foremesG" },
  { name: "Hebel", key: "hebel" },
  { name: "Danfoss", key: "danfoss" },
];

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/marcas/*.{png,jpg,jpeg,webp,avif,svg}",
  { eager: true },
);

const logoMap: Record<string, string> = {};
for (const [path, mod] of Object.entries(modules)) {
  const filename = path.split("/").pop()?.replace(/\.\w+$/, "") ?? "";
  logoMap[filename] = mod.default.src;
}

const brandsWithLogos = brandList.map((brand) => {
  const logoSrc = logoMap[brand.key] ?? null;
  const detail = data.brands[brand.key as keyof typeof data.brands] ?? "";
  return { ...brand, logoSrc, detail };
});
---

<section id="marcas-ancla" class="bg-panel">
  <div class="container-x py-16 lg:py-24">
    <ScrollReveal client:visible>
      <SectionHeading
        topTag={data.topTag}
        title={data.title}
        text={data.subtitle}
        align="center"
      />
    </ScrollReveal>

    {/* Grid de marcas */}
    <div class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        brandsWithLogos.map((brand, index) => (
          <ScrollReveal
            client:visible
            direction="up"
            delay={index * 0.07}
            className="h-full"
          >
            <div class="group flex h-full flex-col items-center justify-center gap-3 rounded-2xl border border-line bg-canvas px-5 py-6 text-center shadow-xs transition-all duration-300 hover:border-secondary/40 hover:shadow-md hover:-translate-y-1">
              <div class="flex h-16 w-full max-w-30 items-center justify-center">
                {brand.logoSrc ? (
                  <img
                    src={brand.logoSrc}
                    alt={`Logo de ${brand.name}`}
                    class="h-full w-full object-contain mix-blend-multiply dark:mix-blend-normal dark:brightness-90"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-secondary/10 group-hover:text-secondary">
                    <span class="text-xl font-extrabold font-display select-none">
                      {brand.name.charAt(0)}
                    </span>
                  </div>
                )}
              </div>

              <p class="font-display text-sm font-bold text-ink">{brand.name}</p>
              {brand.detail && (
                <p class="text-xs text-muted leading-tight">{brand.detail}</p>
              )}
            </div>
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { FiMail, FiMapPin, FiPhone } from "react-icons/fi";
import { contact, footer, navLinks, site } from "@/constants/site";

const productos = (await getCollection("productos")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<footer class="bg-primary text-white">
  <div class="container-x grid gap-12 py-16 lg:grid-cols-4 lg:gap-8">
    <div class="lg:col-span-1">
      <a href="/" class="flex items-center gap-3">
        <Image
          src={site.logo}
          alt={site.logoAlt}
          widths={[160, 320]}
          sizes="160px"
          loading="lazy"
          class="h-14 w-auto object-contain brightness-0 invert"
        />
        <span class="text-sm font-bold text-white leading-tight">
          {site.tagline}
        </span>
      </a>
      <p class="mt-5 text-sm leading-relaxed text-white/70">{footer.about}</p>
    </div>

    <nav aria-label={footer.navTitle}>
      <h2
        class="text-xs font-semibold uppercase tracking-[0.3em] text-secondary"
      >
        {footer.navTitle}
      </h2>
      <ul class="mt-5 space-y-3">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/75 transition-colors duration-200 hover:text-secondary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={footer.productsTitle}>
      <h2
        class="text-xs font-semibold uppercase tracking-[0.3em] text-secondary"
      >
        {footer.productsTitle}
      </h2>
      <ul class="mt-5 space-y-3">
        {
          productos.map((producto) => (
            <li>
              <a
                href={`/productos/${producto.id}`}
                class="text-sm text-white/75 transition-colors duration-200 hover:text-secondary"
              >
                {producto.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2
        class="text-xs font-semibold uppercase tracking-[0.3em] text-secondary"
      >
        {footer.contactTitle}
      </h2>
      <ul class="mt-5 space-y-4 text-sm text-white/75">
        <li class="flex gap-3">
          <FiMapPin
            className="mt-0.5 shrink-0 text-secondary"
            aria-hidden="true"
          />
          <a
            href={contact.addressHref}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200 hover:text-secondary"
          >
            {contact.address}
          </a>
        </li>
        <li class="flex gap-3">
          <FiPhone
            className="mt-0.5 shrink-0 text-secondary"
            aria-hidden="true"
          />
          <a
            href={contact.phoneHref}
            class="transition-colors duration-200 hover:text-secondary"
          >
            {contact.phone}
          </a>
        </li>
        <li class="flex gap-3">
          <FiMail
            className="mt-0.5 shrink-0 text-secondary"
            aria-hidden="true"
          />
          <a
            href={contact.emailHref}
            class="transition-colors duration-200 hover:text-secondary"
          >
            {contact.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="container-x py-6 text-center text-xs text-white/60">
      Made by <a
        href="https://www.optimmkt.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-white/80 hover:text-secondary transition-colors duration-200"
        >Optim</a
      > | {footer.copyright}
    </p>
  </div>
</footer>

---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { FiMail, FiMapPin, FiPhone } from "react-icons/fi";
import { contact, getNavLinks, site } from "@/constants/site";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const navLinks = getNavLinks(lang);
const homeHref = localizePath(lang, "index");

const productos = (
  await getCollection("productos", (item) => item.id.startsWith(`${lang}/`))
).sort((a, b) => a.data.order - b.data.order);

const copyrightText = i18n.footer.copyright.replace(
  "{year}",
  new Date().getFullYear().toString(),
);
---

<footer class="bg-primary text-white">
  <div class="container-x grid gap-12 py-16 lg:grid-cols-4 lg:gap-8">
    <div class="lg:col-span-1">
      <a href={homeHref} class="flex items-center gap-3">
        <Image
          src={site.logo}
          alt={i18n.site.logoAlt}
          widths={[160, 320]}
          sizes="160px"
          loading="lazy"
          class="h-14 w-auto object-contain brightness-0 invert"
        />
        <span class="text-sm font-bold text-white leading-tight">
          {i18n.site.tagline}
        </span>
      </a>
      <p class="mt-5 text-sm leading-relaxed text-white/70">{i18n.footer.about}</p>
    </div>

    <nav aria-label={i18n.footer.navTitle}>
      <h2
        class="text-xs font-semibold uppercase tracking-[0.3em] text-secondary"
      >
        {i18n.footer.navTitle}
      </h2>
      <ul class="mt-5 space-y-3">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/75 transition-colors duration-200 hover:text-secondary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={i18n.footer.productsTitle}>
      <h2
        class="text-xs font-semibold uppercase tracking-[0.3em] text-secondary"
      >
        {i18n.footer.productsTitle}
      </h2>
      <ul class="mt-5 space-y-3">
        {
          productos.map((producto) => {
            const slug = producto.id.replace(`${lang}/`, "");
            return (
              <li>
                <a
                  href={localizePath(lang, "products", slug)}
                  class="text-sm text-white/75 transition-colors duration-200 hover:text-secondary"
                >
                  {producto.data.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div>
      <h2
        class="text-xs font-semibold uppercase tracking-[0.3em] text-secondary"
      >
        {i18n.footer.contactTitle}
      </h2>
      <ul class="mt-5 space-y-4 text-sm text-white/75">
        <li class="flex gap-3">
          <FiMapPin
            className="mt-0.5 shrink-0 text-secondary"
            aria-hidden="true"
          />
          <a
            href={contact.addressHref}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200 hover:text-secondary"
          >
            {i18n.site.address}
          </a>
        </li>
        <li class="flex gap-3">
          <FiPhone
            className="mt-0.5 shrink-0 text-secondary"
            aria-hidden="true"
          />
          <a
            href={contact.phoneHref}
            class="transition-colors duration-200 hover:text-secondary"
          >
            {i18n.site.phone}
          </a>
        </li>
        <li class="flex gap-3">
          <FiMail
            className="mt-0.5 shrink-0 text-secondary"
            aria-hidden="true"
          />
          <a
            href={contact.emailHref}
            class="transition-colors duration-200 hover:text-secondary"
          >
            {i18n.site.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="container-x py-6 text-center text-xs text-white/60">
      Made by <a
        href="https://www.optimmkt.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-white/80 hover:text-secondary transition-colors duration-200"
        >Optim</a
      > | {copyrightText}
    </p>
  </div>
</footer>

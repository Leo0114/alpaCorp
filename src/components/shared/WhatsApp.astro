---
import { FaWhatsapp } from "react-icons/fa";
import { getWhatsapp } from "@/constants/site";
import { getLang } from "@/i18n/i18n";

const lang = getLang(Astro.currentLocale);
const whatsapp = getWhatsapp(lang);
---

<div class="fixed bottom-8 right-8 z-50 flex items-center">
  <a
    href={whatsapp.href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={whatsapp.label}
    class="group relative flex h-13 w-13 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-[#25D366]/30 transition-all duration-300 hover:scale-110 hover:bg-[#20ba5a] hover:shadow-xl hover:shadow-[#20ba5a]/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
  >
    <FaWhatsapp className="h-7 w-7" aria-hidden="true" />

    {/* Tooltip visible on hover / focus */}
    <span
      role="tooltip"
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-lg bg-ink px-3 py-1.5 text-xs font-semibold tracking-wide text-canvas opacity-0 shadow-md transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 translate-x-2"
    >
      {whatsapp.label}
    </span>
  </a>
</div>

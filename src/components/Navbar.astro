---
import { Image } from "astro:assets";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";
import LangToggle from "@/components/shared/LangToggle.astro";
import { getNavLinks, site } from "@/constants/site";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const navLinks = getNavLinks(lang);
const homeHref = localizePath(lang, "index");

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" || href === "/en" || href === "/en/"
    ? pathname === "/" || pathname === "/en" || pathname === "/en/"
    : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-primary">
  <nav
    class="container-x flex h-20 items-center justify-between gap-6"
    aria-label={i18n.nav.home}
  >
    <a
      href={homeHref}
      class="flex shrink-0 items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
    >
      <Image
        src={site.logo}
        alt={i18n.site.logoAlt}
        widths={[160, 320]}
        sizes="160px"
        loading="eager"
        class="h-11 w-auto object-contain brightness-0 invert"
      />
      <span class="text-sm font-bold text-white leading-tight hidden sm:inline-block">
        {i18n.site.tagline}
      </span>
      <span class="sr-only">{i18n.site.name}</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "relative rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-widest transition-colors duration-200",
                isActive(link.href)
                  ? "text-secondary"
                  : "text-white/85 hover:text-secondary",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <LangToggle label={i18n.nav.language} />

      <div class="hidden lg:block">
        <ThemeToggle />
      </div>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={i18n.nav.openMenu}
        class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/25 bg-white/10 text-white transition-colors duration-200 hover:bg-white/20 lg:hidden"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-nav-menu
    hidden
    class="border-t border-white/10 bg-primary lg:hidden"
  >
    <ul class="container-x flex flex-col gap-1 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block rounded-lg px-3 py-3 text-sm font-semibold uppercase tracking-widest transition-colors duration-200",
                isActive(link.href)
                  ? "bg-white/10 text-secondary"
                  : "text-white/85 hover:bg-white/10 hover:text-secondary",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2 flex items-center justify-between px-3">
        <span class="text-xs uppercase text-white/70 font-semibold">{i18n.nav.theme}</span>
        <ThemeToggle />
      </li>
    </ul>
  </div>
</header>

<script>
  let navAbortController: AbortController | null = null;

  function setupNav() {
    if (navAbortController) navAbortController.abort();
    navAbortController = new AbortController();
    const signal = navAbortController.signal;

    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
    if (!toggle || !menu) return;

    menu.hidden = true;
    toggle.setAttribute("aria-expanded", "false");

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener(
      "click",
      () => {
        const isOpen = !menu.hidden;
        if (isOpen) {
          close();
        } else {
          menu.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
        }
      },
      { signal },
    );

    menu.addEventListener(
      "click",
      (event) => {
        if ((event.target as Element).closest("a")) close();
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") close();
      },
      { signal },
    );
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>

---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/shared/Banner.astro";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ProductCard from "@/components/productos/ProductCard.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import heroImage from "@/assets/images/4786.avif";

const lang = getLang(Astro.currentLocale ?? "en");
const i18n = getI18N(lang);
const data = i18n.productos;

const productos = (
  await getCollection("productos", (item) => item.id.startsWith(`${lang}/`))
).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={i18n.seo.productsTitle} description={i18n.seo.productsDescription}>
  <Banner
    title={data.banner.title}
    subtitle={data.banner.subtitle}
    image={heroImage}
    imageAlt={data.banner.imageAlt}
  />

  <section class="bg-canvas">
    <div class="container-x py-16 lg:py-24">
      <SectionHeading
        topTag={data.page.topTag}
        title={data.page.title}
        text={data.page.text}
        align="center"
      />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          productos.map((producto, index) => (
            <ScrollReveal client:visible delay={(index % 3) * 0.1} className="h-full">
              <ProductCard
                producto={producto}
                cta={data.page.cta}
                loading={index < 3 ? "eager" : "lazy"}
              />
            </ScrollReveal>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

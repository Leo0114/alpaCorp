---
import Layout from "@/layouts/Layout.astro";
import HeroSlider from "@/components/home/HeroSlider";
import IndicadoresClave from "@/components/home/IndicadoresClave.astro";
import NuestraEmpresa from "@/components/home/NuestraEmpresa.astro";
import MarcasAncla from "@/components/home/MarcasAncla.astro";
import ProblemasIndustrias from "@/components/home/ProblemasIndustrias.astro";
import Productos from "@/components/home/Productos.astro";
import Cta from "@/components/home/Cta.astro";
import Servicios from "@/components/home/Servicios.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";

import one from "@/assets/images/one.avif";
import two from "@/assets/images/two.avif";
import three from "@/assets/images/three.avif";

const lang = getLang(Astro.currentLocale ?? "en");
const i18n = getI18N(lang);

const heroImages = [one, two, three];
const heroHrefs = [
  localizePath(lang, "contact"),
  "#marcas-ancla",
  localizePath(lang, "about"),
];

const heroSlides = i18n.home.heroSlides.map((slide, i) => ({
  ...slide,
  ctaHref: heroHrefs[i],
  image: heroImages[i],
}));
---

<Layout title={i18n.seo.homeTitle} description={i18n.seo.defaultDescription}>
  {/* Impact */}
  <HeroSlider client:load slides={heroSlides} />

  {/* Key indicators */}
  <IndicadoresClave />

  {/* About us */}
  <NuestraEmpresa />

  {/* Key brands */}
  <MarcasAncla />

  {/* Industry challenges */}
  <ProblemasIndustrias />

  {/* Products */}
  <Productos />

  {/* CTA */}
  <Cta />

  {/* Services */}
  <Servicios />
</Layout>

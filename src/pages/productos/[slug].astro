---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Gallery from "@/components/shared/Gallery.astro";
import ProductCard from "@/components/productos/ProductCard.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { Button } from "@/components/ui/Button";
import { getI18N, getLang } from "@/i18n/i18n";
import { localizePath } from "@/i18n/utils";

export const prerender = true;

export async function getStaticPaths() {
  const productos = await getCollection("productos", (item) => item.id.startsWith("es/"));
  return productos.map((producto) => ({
    params: { slug: producto.id.replace("es/", "") },
    props: { producto },
  }));
}

interface Props {
  producto: CollectionEntry<"productos">;
}

const { producto } = Astro.props;
const { name, description, Image: cover, gallery } = producto.data;
const { Content } = await render(producto);

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const data = i18n.productos.detail;
const contactHref = localizePath(lang, "contact");
const productsHref = localizePath(lang, "products");

const relacionados = (await getCollection("productos", (item) => item.id.startsWith(`${lang}/`)))
  .filter((item) => item.id !== producto.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout title={name} description={description}>
  <section class="relative isolate overflow-hidden bg-primary">
    <Image
      src={cover}
      alt={name}
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      transition:name={`producto-img-${producto.id}`}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-primary/95 via-primary/85 to-primary/50"
      aria-hidden="true"
    >
    </div>

    <div class="container-x py-20 sm:py-24 lg:py-28">
      <a
        href={productsHref}
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/70 transition-colors duration-200 hover:text-secondary"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M11 18l-6-6 6-6"></path>
        </svg>
        {data.backLabel}
      </a>

      <h1
        class="mt-6 max-w-3xl font-display text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl"
        transition:name={`producto-name-${producto.id}`}
      >
        {name}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/80">
        {description}
      </p>
      <span class="mt-6 block h-1 w-20 rounded-full bg-secondary"></span>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="container-x grid gap-12 py-16 lg:grid-cols-3 lg:py-24">
      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl font-extrabold text-ink">
          {data.descriptionTitle}
        </h2>
        <span class="mt-4 block h-1 w-16 rounded-full bg-secondary"></span>
        <div
          class="prose prose-neutral mt-8 max-w-none dark:prose-invert prose-headings:font-display prose-headings:font-bold prose-headings:text-ink prose-p:text-muted prose-li:text-muted prose-strong:text-ink"
        >
          <Content />
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div
          class="sticky top-28 rounded-2xl bg-gradient-to-br from-primary via-primary to-black p-8"
        >
          <h2 class="font-display text-xl font-bold text-white">
            {data.ctaTitle}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-white/80">
            {data.ctaText}
          </p>
          <Button
            variant="secondary"
            size="md"
            href={contactHref}
            className="mt-6 w-full"
          >
            {data.ctaButton}
          </Button>
        </div>
      </aside>
    </div>
  </section>

  {
    gallery && (
      <section class="bg-panel">
        <div class="container-x py-16 lg:py-20">
          <Gallery name={gallery} title={data.galleryTitle} />
        </div>
      </section>
    )
  }

  {
    relacionados.length > 0 && (
      <section class="bg-canvas">
        <div class="container-x py-16 lg:py-20">
          <h2 class="font-display text-2xl font-extrabold text-ink">
            {data.relatedTitle}
          </h2>
          <span class="mt-4 block h-1 w-16 rounded-full bg-secondary" />

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relacionados.map((item, index) => (
              <ScrollReveal client:visible delay={index * 0.1} className="h-full">
                <ProductCard producto={item} cta={i18n.productos.page.cta} />
              </ScrollReveal>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/shared/Banner.astro";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ContactForm from "@/components/contacto/ContactForm";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { FiMail, FiMapPin, FiPhone } from "react-icons/fi";
import { FaWhatsapp } from "react-icons/fa";
import { banner, contactCta, contactForm, mapSection } from "@/constants/contacto";
import { contact, whatsapp } from "@/constants/site";

const datos = [
  { icon: FiMapPin, text: contact.address, href: contact.addressHref, external: true },
  { icon: FiPhone, text: contact.phone, href: contact.phoneHref, external: false },
  { icon: FiMail, text: contact.email, href: contact.emailHref, external: false },
];
---

<Layout title={banner.title} description={contactCta.text}>
  <Banner
    title={banner.title}
    subtitle={banner.subtitle}
    image={banner.image}
    imageAlt={banner.imageAlt}
  />

  <section class="bg-canvas">
    <div class="container-x grid gap-8 py-16 lg:grid-cols-3 lg:py-24">
      <ScrollReveal client:visible direction="right" className="lg:col-span-2">
        <div class="rounded-2xl border border-line bg-panel p-7 sm:p-10">
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-secondary"
          >
            {contactForm.topTag}
          </p>
          <h2 class="font-display text-2xl font-extrabold text-ink sm:text-3xl">
            {contactForm.title}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {contactForm.text}
          </p>
          <span class="mt-6 mb-8 block h-1 w-16 rounded-full bg-secondary"
          ></span>

          <ContactForm client:load />
        </div>
      </ScrollReveal>

      <ScrollReveal
        client:visible
        direction="left"
        delay={0.1}
        className="h-full lg:col-span-1"
      >
        <div
          class="flex h-full flex-col rounded-2xl bg-gradient-to-br from-primary via-primary to-black p-8"
        >
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-secondary"
          >
            {contactCta.topTag}
          </p>
          <h2 class="font-display text-2xl font-extrabold text-white">
            {contactCta.title}
          </h2>
          <span class="mt-6 block h-1 w-16 rounded-full bg-secondary"></span>
          <p class="mt-6 text-sm leading-relaxed text-white/80">
            {contactCta.text}
          </p>

          <ul class="mt-8 space-y-5 text-sm text-white/85">
            {
              datos.map(({ icon: Icon, text, href, external }) => (
                <li class="flex gap-3">
                  <Icon
                    className="mt-0.5 shrink-0 text-lg text-secondary"
                    aria-hidden="true"
                  />
                  <a
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="transition-colors duration-200 hover:text-secondary"
                  >
                    {text}
                  </a>
                </li>
              ))
            }
          </ul>

          <a
            href={whatsapp.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto inline-flex items-center justify-center gap-2 rounded-full bg-secondary px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.2em] text-white transition-colors duration-300 hover:bg-white hover:text-primary"
          >
            <FaWhatsapp className="text-lg" aria-hidden="true" />
            {contactCta.whatsappLabel}
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="bg-panel">
    <div class="container-x py-16 lg:py-20">
      <SectionHeading
        topTag={mapSection.topTag}
        title={mapSection.title}
        align="center"
      />

      <div
        class="mt-12 overflow-hidden rounded-2xl border border-line shadow-lg"
      >
        <iframe
          src={contact.mapEmbed}
          title={mapSection.iframeTitle}
          width="100%"
          height="450"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="block h-[380px] w-full sm:h-[450px]"></iframe>
      </div>
    </div>
  </section>
</Layout>

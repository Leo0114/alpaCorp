---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/shared/Banner.astro";
import NuestraEmpresa from "@/components/home/NuestraEmpresa.astro";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { Button } from "@/components/ui/Button";
import { banner, cta, valores } from "@/constants/quienes-somos";
import { nuestraEmpres } from "@/constants/home";
import Clientes from "@/components/home/Clientes.astro";
---

<Layout title={banner.title} description={nuestraEmpres.p1}>
  <Banner
    title={banner.title}
    subtitle={banner.subtitle}
    image={banner.image}
    imageAlt={banner.imageAlt}
  />

  <NuestraEmpresa showCta={false} id="nuestra-empresa" />

  <section class="bg-panel">
    <div class="container-x py-16 lg:py-24">
      <SectionHeading
        topTag={valores.topTag}
        title={valores.title}
        align="center"
      />

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          valores.items.map((item, index) => (
            <ScrollReveal
              client:visible
              delay={(index % 2) * 0.1}
              className="h-full"
            >
              <article class="h-full rounded-2xl border border-line bg-canvas p-7 transition-colors duration-300 hover:border-secondary">
                <span class="block h-1 w-10 rounded-full bg-secondary" />
                <h3 class="mt-5 font-display text-lg font-bold text-ink">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">
                  {item.text}
                </p>
              </article>
            </ScrollReveal>
          ))
        }
      </div>
    </div>
  </section>
  <Clientes />

  <section class="bg-linear-to-br from-primary via-primary to-black">
    <div class="container-x py-16 text-center lg:py-20">
      <SectionHeading
        topTag={cta.topTag}
        title={cta.title}
        text={cta.text}
        align="center"
        tone="inverse"
      />
      <Button variant="secondary" size="lg" href={cta.href} className="mt-8">
        {cta.bgButton}
      </Button>
    </div>
  </section>
</Layout>

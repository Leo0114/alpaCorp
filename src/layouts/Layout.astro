---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import WhatsApp from "@/components/shared/WhatsApp.astro";
import { Toaster } from "@/components/shared/Toaster";
import { getI18N, getLang } from "@/i18n/i18n";
import { switchLocalePath } from "@/i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);

const { title, description = i18n.seo.defaultDescription } = Astro.props;

const pageTitle = title ? `${title} | ${i18n.seo.shortName}` : `${i18n.seo.shortName} | ${i18n.seo.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const esHref = new URL(switchLocalePath(Astro.url, "es"), Astro.site ?? Astro.url).href;
const enHref = new URL(switchLocalePath(Astro.url, "en"), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/ico.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap"
    />
    <meta name="generator" content={Astro.generator} />

    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <SEO
      title={pageTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: pageTitle,
          type: "website",
          url: canonical,
          image: new URL("/logo.png", Astro.site ?? Astro.url).href,
        },
        optional: {
          siteName: i18n.seo.siteName,
          description,
        },
      }}
      twitter={{ card: "summary_large_image" }}
    />

    <ClientRouter />

    {/* Evita el flash de tema: se aplica antes del primer paint. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = stored ? stored === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-canvas text-ink">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <WhatsApp />
    <Toaster client:idle />

    {/* El tema debe re-aplicarse tras cada view transition. */}
    <script is:inline>
      document.addEventListener("astro:after-swap", () => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark = stored ? stored === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", isDark);
      });
    </script>
  </body>
</html>
